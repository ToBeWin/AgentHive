# AgentHive remote infrastructure.
# Copy to /opt/agenthive/.env.infra on the server and generate strong secrets.

POSTGRES_DB=agenthive
POSTGRES_USER=agenthive
POSTGRES_PASSWORD=change-me-postgres-password
# URL-encoded copy of POSTGRES_PASSWORD for services that need a PostgreSQL URL.
POSTGRES_PASSWORD_URLENCODED=change-me-postgres-password
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB

REDIS_PASSWORD=change-me-redis-password
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_MAXMEMORY=384mb

MINIO_ROOT_USER=agenthive
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BIND_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

LITELLM_MASTER_KEY=sk-change-me-litellm-master-key
# Domestic Tencent Cloud/Aliyun servers can use this GHCR mirror to avoid direct pull timeouts.
# LITELLM_IMAGE=ghcr.nju.edu.cn/berriai/litellm:main-latest
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest
LITELLM_POSTGRES_DB=litellm
# Override only when the server stores its reviewed LiteLLM config elsewhere.
LITELLM_CONFIG_FILE=./infra/litellm/config.yaml
LITELLM_BIND_HOST=127.0.0.1
LITELLM_PORT=4000
OPENAI_COMPATIBLE_API_KEY=sk-agenthive-placeholder
