AGENTHIVE_VERSION=0.3.0-alpha.2
# Loopback-only HTTP origin consumed by the same-host TLS terminator.
HTTP_PORT=8080

# Generate strong unique secrets before production deployment.
POSTGRES_PASSWORD=change-me-postgres-password
# Dedicated LiteLLM database. LiteLLM owns Prisma migrations and must never
# use the AgentHive business database (`agenthive`).
LITELLM_POSTGRES_DB=litellm
REDIS_PASSWORD=change-me-redis-password
MINIO_ROOT_USER=agenthive
MINIO_ROOT_PASSWORD=change-me-minio-password
LITELLM_MASTER_KEY=sk-change-me-litellm-master-key
# Keep gateway and RAG engine images immutable for repeatable/offline delivery.
# Upgrade these values only after acceptance testing the complete AgentHive stack.
LITELLM_IMAGE=ghcr.io/berriai/litellm:sha256-a1745e629abfb17d434426ff48b115f54f4f4c4a0f5af241de569e93c63c411e
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.0
SECRET_KEY=change-me-agenthive-secret-key
# Required production HTTPS origin. The installer rejects this template host;
# replace it with the customer's certificate hostname before --start.
AGENTHIVE_PUBLIC_BASE_URL=https://agenthive.example.com

# API security baseline.
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=redis
AGENTHIVE_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128","172.16.0.0/12"]
AGENTHIVE_FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.16.0.0/12
AGENTHIVE_AUTH_COOKIE_ENABLED=true
AGENTHIVE_AUTH_COOKIE_SECURE=true
AGENTHIVE_KNOWLEDGE_UPLOAD_MAX_BYTES=52428800

# Object storage and deployment identity.
AGENTHIVE_MINIO_SECURE=false
AGENTHIVE_OBJECT_STORAGE_FALLBACK_PATH=/data/agenthive/object-storage-fallback
AGENTHIVE_INSTALL_ID_PATH=/data/agenthive/install-identity.json
AGENTHIVE_LICENSE_PUBLIC_KEY_PATH=/data/agenthive/license_public.pem

# Media generation providers and async provider callbacks.
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_BASE_URL=
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_API_KEY=
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_IMAGE_PATH=/images/generations
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_VIDEO_PATH=/videos/generations
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_STATUS_PATH=/jobs/{external_job_id}
AGENTHIVE_MEDIA_PROVIDER_TIMEOUT_SECONDS=120
AGENTHIVE_MEDIA_OUTPUT_BUCKET=agenthive-media
AGENTHIVE_MEDIA_OUTPUT_DOWNLOAD_MAX_BYTES=262144000
AGENTHIVE_MEDIA_WEBHOOK_SECRET=change-me-media-webhook-secret
AGENTHIVE_MEDIA_WEBHOOK_PUBLIC_URL=
AGENTHIVE_OPENAI_IMAGES_BASE_URL=https://api.openai.com/v1
AGENTHIVE_OPENAI_IMAGES_API_KEY=
AGENTHIVE_NANO_BANANA_BASE_URL=
AGENTHIVE_NANO_BANANA_API_KEY=
AGENTHIVE_VOLCENGINE_SEEDANCE_BASE_URL=
AGENTHIVE_VOLCENGINE_SEEDANCE_API_KEY=
AGENTHIVE_VOLCENGINE_SEEDANCE_STATUS_PATH=/jobs/{external_job_id}

# Ports and optional integrations.
MINIO_CONSOLE_PORT=9001
LITELLM_CONFIG_FILE=./litellm/config.yaml.example
AGENTHIVE_FRONTEND_HEALTH_URL=http://frontend/
RAGFLOW_URL=
RAGFLOW_API_KEY=
RAGFLOW_HEALTH_PATH=/health
RAGFLOW_INGEST_PATH=/api/v1/agenthive/ingest
RAGFLOW_RETRIEVE_PATH=/api/v1/agenthive/retrieve
RAGFLOW_DELETE_PATH=/api/v1/agenthive/documents/{knowledge_base_id}/{document_id}
RAG_EMBEDDING_MODE=deterministic_local
RAG_EMBEDDING_MODEL_KEY=agenthive-local-hash-v1
RAG_EMBEDDING_DIMENSIONS=1536
