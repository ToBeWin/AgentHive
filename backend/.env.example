AGENTHIVE_APP_NAME=AgentHive
AGENTHIVE_APP_VERSION=0.3.0-alpha.2
AGENTHIVE_ENVIRONMENT=development
AGENTHIVE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]

DATABASE_URL=postgresql+asyncpg://agenthive:agenthive_dev_password@localhost:5432/agenthive
REDIS_URL=redis://:agenthive_dev_redis@localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=agenthive
MINIO_SECRET_KEY=agenthive_minio_password
AGENTHIVE_MINIO_SECURE=false
AGENTHIVE_OBJECT_STORAGE_FALLBACK_PATH=.agenthive/object-storage

LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-agenthive-dev-master
AGENTHIVE_FRONTEND_HEALTH_URL=
AGENTHIVE_PUBLIC_BASE_URL=http://localhost:8000

SECRET_KEY=replace-with-a-random-64-byte-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Observability (structured access logs + Prometheus metrics endpoint)
ACCESS_LOG_ENABLED=true
ACCESS_LOG_EXCLUDE_PATHS=["/api/docs","/api/openapi.json","/api/v1/health","/widget/"]
METRICS_ENABLED=true
# Sentry error tracking (optional — leave empty to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Web Widget SDK (embedded on customer sites, requires permissive CORS)
WIDGET_CORS_ENABLED=true
WIDGET_CORS_ORIGINS=["*"]
AGENTHIVE_AGENT_CONCURRENCY_ENABLED=true
AGENTHIVE_AGENT_CONCURRENCY_TENANT_LIMIT=40
AGENTHIVE_AGENT_CONCURRENCY_USER_LIMIT=4
AGENTHIVE_AGENT_CONCURRENCY_AGENT_LIMIT=12
AGENTHIVE_AGENT_CONCURRENCY_WAIT_TIMEOUT_SECONDS=0.2

AGENTHIVE_INSTALL_ID_PATH=.agenthive/install-identity.json
AGENTHIVE_LICENSE_PUBLIC_KEY_PATH=

# Media generation providers and async provider callbacks.
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_BASE_URL=
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_API_KEY=
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_IMAGE_PATH=/images/generations
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_VIDEO_PATH=/videos/generations
AGENTHIVE_MEDIA_OPENAI_COMPATIBLE_STATUS_PATH=/jobs/{external_job_id}
AGENTHIVE_MEDIA_PROVIDER_TIMEOUT_SECONDS=120
AGENTHIVE_MEDIA_OUTPUT_BUCKET=agenthive-media
AGENTHIVE_MEDIA_OUTPUT_DOWNLOAD_MAX_BYTES=262144000
AGENTHIVE_MEDIA_WEBHOOK_SECRET=replace-with-random-media-webhook-secret
AGENTHIVE_MEDIA_WEBHOOK_PUBLIC_URL=
AGENTHIVE_OPENAI_IMAGES_BASE_URL=https://api.openai.com/v1
AGENTHIVE_OPENAI_IMAGES_API_KEY=
AGENTHIVE_NANO_BANANA_BASE_URL=
AGENTHIVE_NANO_BANANA_API_KEY=
AGENTHIVE_VOLCENGINE_SEEDANCE_BASE_URL=
AGENTHIVE_VOLCENGINE_SEEDANCE_API_KEY=
AGENTHIVE_VOLCENGINE_SEEDANCE_STATUS_PATH=/jobs/{external_job_id}

RAGFLOW_URL=
RAGFLOW_API_KEY=
RAGFLOW_HEALTH_PATH=/health
RAGFLOW_INGEST_PATH=/api/v1/agenthive/ingest
RAGFLOW_RETRIEVE_PATH=/api/v1/agenthive/retrieve
RAGFLOW_DELETE_PATH=/api/v1/agenthive/documents/{knowledge_base_id}/{document_id}
RAG_EMBEDDING_MODE=deterministic_local
RAG_EMBEDDING_MODEL_KEY=agenthive-local-hash-v1
RAG_EMBEDDING_DIMENSIONS=1536
# Provider: local_hash (default, offline) | llm_gateway (OpenAI-compatible /embeddings)
RAG_EMBEDDING_PROVIDER=local_hash
RAG_EMBEDDING_API_BASE_URL=
RAG_EMBEDDING_API_KEY=
# Resilience for llm_gateway provider
RAG_EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MAX_RETRIES=2
RAG_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
RAG_EMBEDDING_CIRCUIT_BREAKER_ENABLED=true
RAG_EMBEDDING_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
RAG_EMBEDDING_CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# LLM Gateway circuit breaker (per-deployment)
# Trips OPEN after `failure_threshold` consecutive failures for a deployment,
# skips routing to it for `cooldown_seconds`, then probes (HALF_OPEN) before
# closing after `success_threshold` consecutive probe successes.
# ---------------------------------------------------------------------------
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
LLM_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# ---------------------------------------------------------------------------
# Local / on-prem inference engines (P1: 离网模型支持)
# These expose OpenAI-compatible endpoints and typically require no API key on
# localhost. Setting OLLAMA_BASE_URL (etc.) activates the catalog provider and
# marks it auth_required=False so live calls work without a key.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
VLLM_BASE_URL=
VLLM_API_KEY=
SGLANG_BASE_URL=
SGLANG_API_KEY=
LMSTUDIO_BASE_URL=
LMSTUDIO_API_KEY=
XINFERENCE_BASE_URL=
XINFERENCE_API_KEY=
LOCALAI_BASE_URL=
LOCALAI_API_KEY=
